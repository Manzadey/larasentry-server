{
    "swagger": "2.0",
    "info": {
        "description": "API documentation for LaraSentry Go Server.",
        "title": "LaraSentry API",
        "contact": {},
        "version": "1.0"
    },
    "host": "localhost:8080",
    "basePath": "/",
    "paths": {
        "/api/events": {
            "post": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "Receives an exception/error payload from a Laravel application.",
                "consumes": [
                    "application/json"
                ],
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "events"
                ],
                "summary": "Send a new error event",
                "parameters": [
                    {
                        "description": "Event Payload",
                        "name": "payload",
                        "in": "body",
                        "required": true,
                        "schema": {
                            "$ref": "#/definitions/main.EventPayload"
                        }
                    }
                ],
                "responses": {
                    "202": {
                        "description": "Accepted",
                        "schema": {
                            "type": "object",
                            "additionalProperties": {
                                "type": "string"
                            }
                        }
                    },
                    "400": {
                        "description": "Bad Request",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "403": {
                        "description": "Forbidden",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        },
        "/api/incidents": {
            "get": {
                "security": [
                    {
                        "Bearer": []
                    }
                ],
                "description": "Returns the latest 100 grouped incidents for the authenticated project.",
                "produces": [
                    "application/json"
                ],
                "tags": [
                    "incidents"
                ],
                "summary": "List incidents",
                "responses": {
                    "200": {
                        "description": "OK",
                        "schema": {
                            "type": "array",
                            "items": {
                                "$ref": "#/definitions/main.Incident"
                            }
                        }
                    },
                    "401": {
                        "description": "Unauthorized",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "405": {
                        "description": "Method Not Allowed",
                        "schema": {
                            "type": "string"
                        }
                    },
                    "500": {
                        "description": "Internal Server Error",
                        "schema": {
                            "type": "string"
                        }
                    }
                }
            }
        }
    },
    "definitions": {
        "main.EventPayload": {
            "type": "object",
            "properties": {
                "app_url": {
                    "type": "string"
                },
                "exception_class": {
                    "type": "string"
                },
                "file": {
                    "type": "string"
                },
                "line": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "request_method": {
                    "type": "string"
                },
                "request_url": {
                    "type": "string"
                },
                "stack_trace": {
                    "type": "string"
                }
            }
        },
        "main.Incident": {
            "type": "object",
            "properties": {
                "appURL": {
                    "type": "string"
                },
                "eventsCount": {
                    "type": "integer"
                },
                "exceptionClass": {
                    "type": "string"
                },
                "file": {
                    "type": "string"
                },
                "firstSeenAt": {
                    "type": "string"
                },
                "hash": {
                    "type": "string"
                },
                "id": {
                    "type": "integer",
                    "format": "int64"
                },
                "lastSeenAt": {
                    "type": "string"
                },
                "line": {
                    "type": "integer"
                },
                "message": {
                    "type": "string"
                },
                "projectID": {
                    "type": "integer",
                    "format": "int64"
                },
                "requestURL": {
                    "type": "string"
                },
                "stackTrace": {
                    "type": "string"
                }
            }
        }
    },
    "securityDefinitions": {
        "Bearer": {
            "description": "Type \"Bearer\" followed by a space and API key.",
            "type": "apiKey",
            "name": "Authorization",
            "in": "header"
        }
    }
}